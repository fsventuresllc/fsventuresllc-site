# cs-waitlist: shared waitlist endpoint (api/). Every value is optional; until RESEND_API_KEY,
# WAITLIST_AUDIENCE_ID and TURNSTILE_SECRET_KEY are all set, POST /api/v1/waitlist answers
# 503 waitlist_not_configured. Each one is also in api/src/env.ts and render.yaml (sync: false).

PORT=4000

# Full-access Resend key (contact properties + contacts). This service never sends email.
RESEND_API_KEY=

# Resend audience/segment "Waitlist" (created 2026-10-19 by cs-waitlist).
WAITLIST_AUDIENCE_ID=28fba1a4-6f92-4ee5-88db-5ae20bc59e7d

# Secret of the Turnstile widget "F&S waitlist (teaser pages)", site key 0x4AAAAAAFbtrCIwCZhASyIy.
# For local work Cloudflare's always-pass test secret is 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=

# Injected by Render on every service; deliberately NOT in render.yaml.
RENDER_GIT_COMMIT=
